# Database
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Resend Email
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=rezervace@yourdomain.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3020

# Cron (Vercel) — chrání /api/cron/* endpointy
CRON_SECRET=change-me

# Platby online / zálohy — bez konfigurace brány appka běží bez online plateb.
# Preferuje se GoPay; když není nastavená, použije se Stripe.

# GoPay (česká brána)
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
# volitelné: sandbox = https://gw.sandbox.gopay.com/api ; default produkce
GOPAY_API_URL=

# Stripe (alternativa)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMS notifikace (nepovinné). SMS_PROVIDER = smsbrana | twilio
SMS_PROVIDER=
# smsbrana.cz
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
