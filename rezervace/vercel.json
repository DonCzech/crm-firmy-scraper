{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev -p 3020",
  "installCommand": "npm install",
  "//regions": "Databáze (Neon) běží v eu-central-1. Funkce dřív běžely v iad1 (USA), takže každý dotaz letěl přes Atlantik — čtyři dotazy = přes 4 s. fra1 je u databáze.",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
