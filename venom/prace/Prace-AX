        if(has.rowCount){ await c.query('rollback'); skip++; continue; }
        const a=await c.query(\"select min(order_index) oi from sections where tenant_id=\$1 and page_id=\$2 and section_type in ('contact','footer')\",[ten.id,pid]);
        const m=await c.query('select coalesce(max(order_index),-1)+1 oi from sections where tenant_id=\$1 and page_id=\$2',[ten.id,pid]);
