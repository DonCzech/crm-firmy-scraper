const anim = { initial: { opacity: 0, y: 10 }, animate: { opacity: 1, y: 0 }, exit: { opacity: 0, y: -10 }, transition: { duration: 0.19 } };

export function GroomingPaws({ b, sectionId }: DesignProps) {
