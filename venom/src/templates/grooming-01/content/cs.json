  "faq": {
    "heading": "Časté dotazy",
    "kicker": "FAQ",
    "items": [
      {
        "question": "Jak dlouho trvá kompletní grooming?",
        "answer": "Záleží na velikosti psa a stavu srsti. Malá plemena obvykle 1,5–2 hodiny, střední 2–3 hodiny a velká plemena 3–5 hodin. Termín vždy plánujeme s rezervou, aby na mazlíčka nikdo nespěchal."
      },
      {
        "question": "Musím se objednat předem?",
        "answer": "Ano, pracujeme výhradně na objednávku. Volné termíny bývají obsazené 1–3 týdny dopředu, proto doporučujeme rezervovat s předstihem."
      },
      {
        "question": "Jakou kosmetiku používáte?",
        "answer": "Pracujeme s přírodní prémiovou kosmetikou bez sulfátů a parabenů, šetrnou ke kůži i srsti. Na přání použijeme i kosmetiku, kterou přinesete."
      },
      {
        "question": "Groomujete i kočky?",
        "answer": "Ano, specializujeme se i na kočičí grooming. Střih a úpravu srsti kočky nabízíme od 890 Kč."
      },
      {
        "question": "Co když má pes strach nebo je neklidný?",
        "answer": "Máme zkušenosti i s úzkostnými mazlíčky. Postupujeme pomalu, s klidem a pauzami — pohodlí a bezpečí zvířete je pro nás vždy na prvním místě."
      }
    ],
    "subtitle": "Nenašli jste odpověď? Napište nám — rádi poradíme s čímkoli okolo péče o vašeho mazlíčka."
  },
