  "faq": {
    "heading": "Časté dotazy",
    "kicker": "FAQ",
    "items": [
      {
        "question": "Jak dlouho trvá celkový grooming?",
        "answer": "Záleží na velikosti psa a stavu jeho srsti. Malá plemena obvykle 1,5–2 hodiny, střední 2–3 hodiny a velká plemena 3–5 hodin."
      },
      {
        "question": "Je nutné se předem objednat?",
        "answer": "Ano, pracujeme výhradně na objednávku. Termíny bývají obsazeny 1–3 týdny dopředu, doporučujeme rezervovat s předstihem."
      },
      {
        "question": "Jakou kosmetiku používáte?",
        "answer": "Používáme přírodní prémiovou kosmetiku bez sulfátů a parabenů, šetrnou ke kůži i srsti. Na vyžádání pracujeme i s kosmetikou od majitele."
      },
      {
        "question": "Groomujete i kočky?",
        "answer": "Ano, specializujeme se i na kočičí grooming. Střih a úprava srsti kočky od 890 Kč."
      }
    ]
