  "team": {
    "heading": "Forma studio | architekti",
    "tagline": "Každý dům nese stopu svého architekta. Proto pečlivě vybíráme lidi, kteří svou práci berou jako osobní závazek — ne jako zakázku.",
    "ctaText": "Poznat architekty",
    "ctaHref": "/architekti",
    "members": [
      {
        "name": "Martin Kovář",
        "role": "Vedoucí architekt",
        "imageUrl": "/templates/arch-01/team-1.webp",
        "bio": "Vystudoval FA VUT v Brně a pracovní stáže absolvoval v Kodani a Barceloně. Specializuje se na rezidenční architekturu s důrazem na vztah stavby a krajiny."
      },
      {
        "name": "Lucie Nováková",
        "role": "Architektka a interiérová designérka",
        "imageUrl": "/templates/arch-01/team-2.webp",
        "bio": "Absolventka AVU Praha, obor design prostoru. Odpovídá za interiérové projekty a výběr materiálů. Věří, že detaily rozhodují o tom, jak se v domě cítíme."
      },
      {
        "name": "Ondřej Šimánek",
        "role": "Architekt a BIM koordinátor",
        "imageUrl": "/templates/arch-01/team-3.webp",
        "bio": "Odborník na digitální projektování a koordinaci stavby. Zajišťuje bezchybný průchod projektu od konceptu přes dokumentaci až po realizaci."
      }
    ]
  },
