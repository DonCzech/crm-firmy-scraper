    "posts": [
      {
        "title": "Střecha jako pátá fasáda",
        "date": "12. 4. 2026",
        "excerpt": "Na nové vile v Říčanech jsme navrhli zelenou střechu, která organicky propojuje objekt s okolním terénem a zároveň reguluje tepelné zisky.",
        "imageUrl": "/templates/arch-01/reel-1.webp",
        "href": "/realizace"
      },
      {
        "title": "Světlo jako stavební materiál",
        "date": "3. 4. 2026",
        "excerpt": "Velkoformátová okna rezidence v Plzni jsou navržena tak, aby sledovala pohyb slunce — ranní světlo v ložnici, odpolední v obývacím pokoji.",
        "imageUrl": "/templates/arch-01/reel-2.webp",
        "href": "/realizace"
      },
      {
        "title": "Hrubá stavba Hradec Králové",
        "date": "27. 3. 2026",
        "excerpt": "Nosná konstrukce vily v Hradci Králové je hotová. Tvar, který byl měsíce jen na papíře, konečně stojí v krajině a začíná dávat smysl v plném měřítku.",
        "imageUrl": "/templates/arch-01/reel-3.webp",
        "href": "/realizace"
      },
      {
        "title": "Dřevo, kámen, sklo",
        "date": "18. 3. 2026",
        "excerpt": "Tři materiály, jeden příběh. Na projektu v Jihlavě jsme pracovali s jejich přirozeným kontrastem — drsnost kamene, teplo dřeva, průhlednost skla.",
        "imageUrl": "/templates/arch-01/reel-4.webp",
        "href": "/realizace"
      }
    ]
  },
