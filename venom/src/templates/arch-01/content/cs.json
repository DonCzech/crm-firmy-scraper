  "about": {
    "heading": "Forma studio | ateliér",
    "tagline": "Tvar, světlo, prostor. Architektura, která zůstane.",
    "body": "Věříme, že dobrý dům není jen dobře postavený dům. Je to místo, kde se život odehrává přirozeně a bez kompromisů. Každý projekt tvoříme od prvního náčrtu až po předání klíčů — s plným soustředěním na detail, materiál a váš způsob života. Forma studio bylo založeno s přesvědčením, že nadčasová architektura vzniká z poctivého dialogu mezi architektem a klientem.",
    "ctaText": "Zjistit více",
    "ctaHref": "/atelier",
    "imageUrl": "/templates/arch-01/about.webp",
    "imageAlt": "Forma studio ateliér"
  },
  "interiors": {
    "heading": "Forma studio | interiéry",
