    "kicker": "Recenze našich zákazníků",
    "heading": "Ověřené zkušenosti od lidí, kteří už nakoupili.",
    "reviews": [
      {
        "name": "Kamila",
        "date": "8. července 2026",
        "rating": 5,
        "text": "Sérum používám třetí měsíc a pleť mám viditelně jednotnější — kolegyně se ptaly, co jsem změnila. Oceňuji i poctivé rady v e-mailu, jak sérum kombinovat s SPF. Balíček dorazil druhý den, krásně zabalený v hedvábném papíru.",
        "productLabel": "Rozjasňující sérum s vitaminem C 30 ml",
        "productHref": "/obchod/velvetier-serum-c",
        "image": "/templates/eshop-07/cream-sm.webp"
      },
      {
        "name": "Tereza",
        "date": "3. července 2026",
        "rating": 5,
        "text": "Aurora je přesně ta vůně, kterou jsem roky hledala — svěží, ale ne obyčejná. Vydrží mi na kůži od rána do večera. Podle doporučení jsem si nejdřív objednala vzorek, což je služba, kterou jinde nenajdete.",
        "productLabel": "Aurora parfémová voda 50 ml",
        "productHref": "/obchod/nordic-bloom-aurora",
        "image": "/templates/eshop-07/vials-sm.webp"
      },
      {
        "name": "Martin",
        "date": "27. června 2026",
        "rating": 5,
        "text": "Kupoval jsem dárek pro ženu a vůbec jsem nevěděl, kde začít. Napsal jsem na poradnu, do hodiny přišel tip na tři vůně a trefa hned napoprvé. Dárkové balení s mašlí vypadalo, jako by ho balili v butiku.",
        "productLabel": "Dárková sada Signature",
        "productHref": "/obchod/darkova-sada-signature",
        "image": "/templates/eshop-07/gift-sm.webp"
      }
    ]
