# Build output — regenerated by the prebuild hook (npm run catalog:generate).
# Must stay ignored *and* the hook must stay in package.json: src/lib/templates/
# design-catalog.ts imports this file, so a build without it fails.
venom/src/generated/

# Scraped clone assets — hundreds of MB of third-party binaries, not source.
venom/template-lab/clones/
venom/public/clones/

# Local scratch/debug leftovers — never part of the app.
venom/tmp/
venom/tmp-*.mjs
venom/h1-*.js
venom/g01_subpages.js
venom/page2.html
venom/screenlog.0
venom/*.log
venom/.runtime-dev-*.log
