# ──────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────
DATABASE_URL="postgresql://bezrealitky:bezrealitky@localhost:5432/bezrealitky?schema=public"

# ──────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──────────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────────
JWT_SECRET="change-me-super-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ──────────────────────────────────────────────────
# S3 / MINIO
# ──────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-central-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="bezrealitky"

# ──────────────────────────────────────────────────
# STRIPE
# ──────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STANDARD="price_standard_..."
STRIPE_PRICE_PREMIUM="price_premium_..."

# ──────────────────────────────────────────────────
# EMAIL (Resend)
# ──────────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@bezrealitky.cz"

# ──────────────────────────────────────────────────
# APP
# ──────────────────────────────────────────────────
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
PORT=4000
NODE_ENV="development"

# ──────────────────────────────────────────────────
# SENTRY
# ──────────────────────────────────────────────────
SENTRY_DSN=""
