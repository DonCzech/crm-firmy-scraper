# ══════════════════════════════════════════════════════════════════
# Základ provozu
# ══════════════════════════════════════════════════════════════════

# Databáze (Neon.tech / PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (next-auth) — vygenerovat: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://ceskypartner.cz

# Produkční doména — canonical URL, sitemap, OG obrázky, e-maily
NEXT_PUBLIC_SITE_URL=https://ceskypartner.cz

# Ochrana /api/cron/* endpointů — vygenerovat: openssl rand -hex 24
CRON_SECRET=

# Cloudflare R2 (média) — volitelné, bez R2 se ukládá do public/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# SMTP se konfiguruje v admin Nastavení → E-mail / SMTP (ukládá se do DB)

# ══════════════════════════════════════════════════════════════════
